# Formatting rules, read by Android Studio. This is the one place the house style is stated.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 127

[*.{yml,yaml,xml,toml}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf
